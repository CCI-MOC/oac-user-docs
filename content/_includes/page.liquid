<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />

    <title>{{ title }}</title>
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header noprint">
      <a href="/"><img src="/assets/toa-black-small.png" alt="TOA Logo" class="site-logo"></a>
    </header>

    <main class="page-content{% if contentClass %} {{ contentClass }}{% endif %}">
      <div class="page-title">
        <h1>{{ title }}</h1>
      </div>
      {% if toc %}
      <aside class="toc-container">
        <h2>Table of Contents</h2>
        {{ content | toc }}
      </aside>
      {% endif %}
      {{ content }}
    </main>

    <footer>
      Copyright &copy; {% year %} Mass Open Cloud |
      Revision: <a href="{{ repository.url }}/commit/{{ vc.revision }}">{{ vc.revision | slice: 0, 10 }}</a> @ {{ vc.date }}
      <span class="noprint"> |
        <a href="{{ repository.url }}/blob/{{ repository.ref }}/{{ page.inputPath }}?plain=1">View page source</a> |
        <a href="{{ repository.url }}/edit/{{ repository.ref }}/{{ page.inputPath }}">Suggest changes</a>
      </span>
    </footer>
  </body>
</html>

